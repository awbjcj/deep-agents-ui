# LangGraph Deployment URL (required)
NEXT_PUBLIC_DEPLOYMENT_URL=https://your-deployment-url.langgraph.app

# LangSmith API Key (optional, for tracing)
#
# WARNING: every NEXT_PUBLIC_* value is inlined into the JavaScript bundle and
# is therefore readable by anyone who loads the page. Only set this to a key
# scoped to what an end user may already do, and rotate it if it leaks. Leave
# blank when the UI talks to the backend proxy (the default), which
# authenticates with the signed-in user's own JWT.
NEXT_PUBLIC_LANGSMITH_API_KEY=

# Dev-only override for the /api/* proxy target used by `next dev`.
# Must be an http: or https: URL; anything else fails the config at startup.
# LANGGRAPH_API_URL=http://localhost:2024
